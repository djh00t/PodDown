{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poddown.dev/schemas/v1/episode-package.schema.json",
  "title": "PodDown episode package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "episode_version_id", "files", "provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "episode_version_id": {"type": "string", "format": "uuid"},
    "files": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "media_type", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source_sha256", "script_version", "profile_version", "renderer", "qa", "critical_token_accuracy", "final_sha256"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "script_version": {"type": "integer", "minimum": 1},
        "profile_version": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "qa": {"const": "pass"},
        "critical_token_accuracy": {"const": 1.0},
        "final_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    }
  }
}
